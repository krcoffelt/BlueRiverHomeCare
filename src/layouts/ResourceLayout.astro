---
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";
import Breadcrumbs from "../components/layout/Breadcrumbs.astro";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  entry: CollectionEntry<"resources">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const canonicalPath = `/resources/${entry.id}/`;
const articleUrl = new URL(canonicalPath, "https://www.blueriverhomecare.com").toString();
const dateFormatter = new Intl.DateTimeFormat("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});
const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://www.blueriverhomecare.com/",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Resources",
      item: "https://www.blueriverhomecare.com/resources/",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: entry.data.title,
      item: `https://www.blueriverhomecare.com${canonicalPath}`,
    },
  ],
};
const articleSchema = {
  "@type": "Article",
  "@id": `${articleUrl}#article`,
  headline: entry.data.title,
  description: entry.data.description,
  url: articleUrl,
  mainEntityOfPage: articleUrl,
  datePublished: entry.data.publishedAt.toISOString(),
  dateModified: entry.data.updatedAt.toISOString(),
  author: {
    "@type": "Person",
    name: entry.data.author,
    jobTitle: "Director of Operations",
    worksFor: { "@id": "https://www.blueriverhomecare.com/#business" },
  },
  publisher: { "@id": "https://www.blueriverhomecare.com/#business" },
  citation: entry.data.sources.map((source) => source.url),
};
---

<BaseLayout
  title={entry.data.seoTitle}
  description={entry.data.description}
  canonicalPath={canonicalPath}
  pageType="article"
  schema={[breadcrumbSchema, articleSchema]}
>
  <section class="page-hero resource-hero" data-cta-threshold>
    <div class="narrow-container">
      <Breadcrumbs
        items={[
          { label: "Home", href: "/" },
          { label: "Resources", href: "/resources/" },
          { label: entry.data.title },
        ]}
      />
      <p class="eyebrow">{entry.data.eyebrow}</p>
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.description}</p>
      <div class="resource-meta-line">
        <span>By {entry.data.author}</span>
        <span>Updated {dateFormatter.format(entry.data.updatedAt)}</span>
        <span>{entry.data.readingTime}</span>
      </div>
    </div>
  </section>
  <article class="section article-body">
    <div class="article-container">
      <Content />
      <section class="article-sources" aria-labelledby="article-sources-title">
        <h2 id="article-sources-title">Sources</h2>
        <p>
          Blue River uses primary public sources so families can verify benefit,
          coverage, and care-planning information directly.
        </p>
        <ul>
          {
            entry.data.sources.map((source) => (
              <li>
                <a href={source.url}>{source.title}</a>
                <span> — {source.publisher}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </article>
</BaseLayout>
